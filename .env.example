# Set these server-side on the Next.js host. Use the Apps Script web app URL ending in /exec.
MASTERCLASS_APPS_SCRIPT_URL=
MASTERCLASS_APPS_SCRIPT_SECRET=

# Set this to the public origin, such as https://www.example.com.
NEXT_PUBLIC_SITE_URL=

# Optional event details. Include the time zone in the date/time.
MASTERCLASS_DATE_TIME=
MASTERCLASS_FORMAT=
MASTERCLASS_FEE=
